# gmail-triage-bot configuration (documentation only — placeholders, no real values).
#
# Real values live in a single env file that config.py reads directly:
#   ~/.config/gmail-triage-bot/.env   (chmod 600, never committed)
# Copy the keys below into that file and fill them in. This .env.example is the
# only env file committed to the repo.
#
# The bot fails loud (ConfigError naming the missing key) if any required key is
# absent or empty — a misconfigured deploy never runs with blank credentials.

# --- Telegram (create a bot via @BotFather) --------------------------------
# On a shared host you can suffix a per-bot token; the suffixed key wins.
TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN_GMAIL=        # optional per-bot override
TELEGRAM_CHAT_ID=                  # numeric chat id that receives the cards

# --- Gmail OAuth (Google Cloud Console > Credentials > OAuth client) --------
# Scope gmail.modify. Run `python -m gmail_bot.auth` to mint the refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=               # minted by `python -m gmail_bot.auth`
GMAIL_TOKEN_URI=https://oauth2.googleapis.com/token
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.modify
# GMAIL_ACCESS_TOKEN=              # optional short-lived bearer for a live proof run

# --- Owner signature identity (injected into the reply system prompt) -------
# Kept in env so no personal contact detail is ever hardcoded in the source.
GMAIL_SELF_ADDRESS=                # your email; also the self-test recipient
GMAIL_OWNER_NAME=                  # name in the signature block
GMAIL_OWNER_PHONE=                 # phone in the signature block

# --- Draft-generation provider seam ----------------------------------------
# LLM_PROVIDER selects the backend:
#   openai (default) -> requires OPENAI_API_KEY, default model gpt-4.1-mini
#   anthropic        -> requires ANTHROPIC_API_KEY, model claude-sonnet-4-6
# Only the ACTIVE provider's key is required; the other may be left empty.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Optional override for the draft model (e.g. gpt-4o, gpt-5-mini). Default gpt-4.1-mini.
# Note: there is no LLM triage step (triage is a Gmail query filter), so there is
# no GMAIL_TRIAGE_MODEL knob — only the reply-draft model is configurable.
GMAIL_DRAFT_MODEL=
# Kept for switch-back only (LLM_PROVIDER=anthropic).
ANTHROPIC_API_KEY=
